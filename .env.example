# Copy to .env and fill in for local development (`vercel dev`).
# On the live site these go in Vercel → Project → Settings → Environment Variables.
# Never commit .env — it is in .gitignore.

# ── GoHighLevel (already set in Vercel) ─────────────────────
GHL_LOCATION_ID=
GHL_TOKEN=

# ── Stripe: Business Show 2026 offer, £99/month for life ───
# Secret key: Stripe Dashboard → Developers → API keys.
# Use sk_test_… while testing, sk_live_… when you go live.
STRIPE_SECRET_KEY=

# Price ID of the £99/month recurring price (starts price_…):
# Stripe Dashboard → Product catalogue → your bundle product → Pricing.
STRIPE_SHOW_PRICE_ID=price_1UaMfmBdqYbaDfVseJCpyw3O
