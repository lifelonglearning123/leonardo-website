# Copy to .env and fill in for local development (`vercel dev`).
# On the live site these go in Vercel → Project → Settings → Environment Variables.
# Never commit .env — it is in .gitignore.

# ── GoHighLevel (already set in Vercel) ─────────────────────
GHL_LOCATION_ID=
GHL_TOKEN=

# ── Stripe: Business Show 2026 offer, £99/month for life ───
# Secret key: Stripe Dashboard → Developers → API keys.
# Use sk_test_… while testing, sk_live_… when you go live.
STRIPE_SECRET_KEY=

# Optional. The £99/month price and the 20% VAT rate are already set as
# defaults in api/checkout.js; only set these to point at different ones.
# STRIPE_SHOW_PRICE_ID=price_1UaMfmBdqYbaDfVseJCpyw3O
# STRIPE_VAT_RATE_ID=txr_1UaMsoBdqYbaDfVsgj0Z1z7D

# ── Retell: the AI assistant rings whoever sends the Business Show form ──
# All three are needed; with any missing, no call is placed and the form
# works as before. The agent's script is agent/show-call-prompt.md.
RETELL_API_KEY=
SHOW_CALL_AGENT_ID=
SHOW_CALL_FROM_NUMBER=
# Optional. "false" stops the calls without a deploy; the cap is calls per 24 hours.
# SHOW_CALL_ENABLED=true
# SHOW_CALL_DAILY_CAP=60

# ── WhatsApp: the business_show_first_contact template to whoever sends the show form ──
# Sent from the "Leonardo whatsapp" client in the WhatsApp console. Both needed;
# the secret is the console's NEXUS_PARTNER_SECRET. Without them nothing is sent.
WHATSAPP_CONSOLE_URL=https://whatsapp-alpha-gilt.vercel.app
WHATSAPP_CONSOLE_SECRET=
# Optional. "false" stops the messages without a deploy.
# SHOW_WHATSAPP_ENABLED=true
